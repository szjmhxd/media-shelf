QWidget {
    background: #f6f7f9;
    color: #1f2328;
    font-family: "Microsoft YaHei UI", "PingFang SC", "Noto Sans CJK SC", sans-serif;
    font-size: 12px;
}

QLabel#pathLabel {
    color: #3a4048;
    font-family: Consolas, monospace;
    padding: 2px 4px;
}

QLabel#hintLabel {
    color: #6e7781;
}

QLabel#titleLabel {
    font-size: 13px;
    font-weight: 600;
    color: #1f2328;
}

QPushButton {
    background: #ffffff;
    border: 1px solid #d0d7de;
    border-radius: 6px;
    padding: 6px 14px;
    color: #1f2328;
}
QPushButton:hover { background: #f3f4f6; border-color: #b6bfc9; }
QPushButton:pressed { background: #eaecef; }
QPushButton:disabled { color: #9aa4af; background: #f4f5f7; border-color: #e3e6ea; }

QPushButton#primaryButton {
    background: #1f6feb;
    border: 1px solid #1f6feb;
    color: #ffffff;
    font-weight: 600;
}
QPushButton#primaryButton:hover { background: #1a63d2; }
QPushButton#primaryButton:pressed { background: #1758bd; }

QLineEdit, QComboBox {
    background: #ffffff;
    border: 1px solid #d0d7de;
    border-radius: 6px;
    padding: 5px 8px;
    selection-background-color: #cfe3ff;
}
QLineEdit:focus, QComboBox:focus { border-color: #1f6feb; }
QComboBox::drop-down { border: none; width: 18px; }
QComboBox QAbstractItemView {
    background: #ffffff;
    border: 1px solid #d0d7de;
    selection-background-color: #e8f0fe;
    selection-color: #1f2328;
}

QTableWidget {
    background: #ffffff;
    alternate-background-color: #fafbfc;
    border: 1px solid #e1e4e8;
    border-radius: 8px;
    gridline-color: #eef0f3;
    selection-background-color: #e8f0fe;
    selection-color: #1f2328;
}
QTableWidget::item { padding: 3px 5px; }
QHeaderView::section {
    background: #f0f2f5;
    color: #57606a;
    border: none;
    border-right: 1px solid #e5e8eb;
    border-bottom: 1px solid #e1e4e8;
    padding: 6px 6px;
    font-weight: 600;
}

QPlainTextEdit {
    background: #ffffff;
    border: 1px solid #e1e4e8;
    border-radius: 8px;
    color: #3a4048;
}

QProgressBar {
    background: #e9ecef;
    border: none;
    border-radius: 3px;
    text-align: center;
    color: transparent;
}
QProgressBar::chunk { background: #1f6feb; border-radius: 3px; }

QCheckBox { spacing: 6px; color: #3a4048; }
QCheckBox::indicator {
    width: 14px; height: 14px;
    border: 1px solid #c3cbd4;
    border-radius: 3px;
    background: #ffffff;
}
QCheckBox::indicator:checked { background: #1f6feb; border-color: #1f6feb; }

QStatusBar { color: #57606a; background: #f0f2f5; }
QMenuBar { background: #f6f7f9; }
QMenuBar::item:selected { background: #e8f0fe; }
QMenu { background: #ffffff; border: 1px solid #d0d7de; }
QMenu::item:selected { background: #e8f0fe; }
